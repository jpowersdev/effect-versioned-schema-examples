{
  "name": "effect-versioned-schema-examples",
  "private": true,
  "type": "module",
  "license": "MIT",
  "packageManager": "pnpm@11.20.0",
  "engines": {
    "node": ">=24.12.0"
  },
  "scripts": {
    "start": "node src/main.ts",
    "demo": "node src/main.ts",
    "demo:old-client": "node src/main.ts old-client",
    "demo:old-server": "node src/main.ts old-server",
    "demo:unrepresentable": "node src/main.ts unrepresentable",
    "example:storage": "node examples/storage.ts",
    "example:onboarding": "node examples/onboarding.ts",
    "example:rpc": "node examples/rpc.ts",
    "example:cluster": "node examples/cluster.ts",
    "bench": "node benchmarks/run.ts",
    "check": "tsc --noEmit",
    "format": "dprint fmt",
    "lint": "dprint check",
    "test": "pnpm check && vitest run",
    "test:http": "vitest run test/Http.test.ts",
    "test:schema": "vitest run test/Schema.test.ts",
    "build:snapshot": "node scripts/build-snapshot.mjs",
    "verify:snapshot": "node scripts/verify-snapshot.mjs snapshot.json benchmarks/snapshot.json"
  },
  "dependencies": {
    "effect": "https://github.com/jpowersdev/effect-versioned-schema-examples/releases/download/snapshot-8fa8f7c1b2/effect-4.0.7-versioned.8fa8f7c1b2.tgz",
    "@effect/platform-node": "https://github.com/jpowersdev/effect-versioned-schema-examples/releases/download/snapshot-8fa8f7c1b2/effect-platform-node-4.0.7-versioned.8fa8f7c1b2.tgz",
    "@effect/sql-sqlite-node": "https://github.com/jpowersdev/effect-versioned-schema-examples/releases/download/snapshot-8fa8f7c1b2/effect-sql-sqlite-node-4.0.7-versioned.8fa8f7c1b2.tgz"
  },
  "devDependencies": {
    "@effect/vitest": "https://github.com/jpowersdev/effect-versioned-schema-examples/releases/download/snapshot-8fa8f7c1b2/effect-vitest-4.0.7-versioned.8fa8f7c1b2.tgz",
    "typescript": "7.0.2",
    "@types/node": "26.6.5",
    "vitest": "5.0.5",
    "dprint": "0.63.0",
    "effect-base": "https://github.com/jpowersdev/effect-versioned-schema-examples/releases/download/snapshot-c065ed7b2c/effect-4.0.7-base.c065ed7b2c.tgz"
  }
}
