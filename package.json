{
  "name": "effect-versioned-schema-examples",
  "private": true,
  "type": "module",
  "license": "MIT",
  "packageManager": "pnpm@11.20.0",
  "engines": {
    "node": ">=24.12.0"
  },
  "scripts": {
    "start": "node src/main.ts",
    "demo": "node src/main.ts",
    "demo:old-client": "node src/main.ts old-client",
    "demo:old-server": "node src/main.ts old-server",
    "demo:unrepresentable": "node src/main.ts unrepresentable",
    "example:storage": "node examples/storage.ts",
    "example:rpc": "node examples/rpc.ts",
    "example:cluster": "node examples/cluster.ts",
    "check": "tsc --noEmit",
    "test": "pnpm check && node --test test/*.test.ts",
    "test:http": "node --test test/Http.test.ts",
    "test:schema": "node --test test/Schema.test.ts",
    "build:snapshot": "node scripts/build-snapshot.mjs",
    "verify:snapshot": "node scripts/verify-snapshot.mjs"
  },
  "dependencies": {
    "effect": "https://github.com/jpowersdev/effect-versioned-schema-examples/releases/download/snapshot-ee7ab8096f/effect-4.0.7-versioned.ee7ab8096f.tgz",
    "@effect/platform-node": "https://github.com/jpowersdev/effect-versioned-schema-examples/releases/download/snapshot-ee7ab8096f/effect-platform-node-4.0.7-versioned.ee7ab8096f.tgz",
    "@effect/sql-sqlite-node": "https://github.com/jpowersdev/effect-versioned-schema-examples/releases/download/snapshot-ee7ab8096f/effect-sql-sqlite-node-4.0.7-versioned.ee7ab8096f.tgz"
  },
  "devDependencies": {
    "typescript": "7.0.2",
    "@types/node": "26.6.5"
  }
}
